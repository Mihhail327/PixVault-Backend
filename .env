# --- Настройки базы данных ---
# Если запускаешь локально (без Docker): host = localhost
# Если в Docker-compose: host = db
DATABASE_URL=postgresql://postgres:3321@db:5432/pixvault

# --- Безопасность ---
SECRET_KEY=e83a6... # используй длинную случайную строку
FERNET_KEY=ГЕНЕРИРОВАННЫЙ_КЛЮЧ

# --- Хранилище ---
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880  # 5MB в байтах

# --- Окружение ---
FLASK_ENV=production