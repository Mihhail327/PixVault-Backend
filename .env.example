# --- Настройки базы данных ---
# Если запускаешь локально (без Docker): host = localhost
# Если в Docker-compose: host = db
DATABASE_URL=postgresql://pixvault:pixvault@db:5432/pixvault

# --- Безопасность ---
SECRET_KEY=your-super-secret-key-here
FERNET_KEY=your-fernet-key-here

# --- Хранилище ---
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880  # 5MB в байтах

# --- Окружение ---
FLASK_ENV=production
FLASK_APP=pixvault_backend.app:create_app